@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Literata:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');
@import 'tailwindcss';

@theme {
  --color-bg: #0a0f1a;
  --color-bg-deep: #060b14;
  --color-bg-card: #111827;
  --color-bg-ivory: #1e293b;
  --color-text: #f0f6fc;
  --color-text-2: #94a3b8;
  --color-text-3: #64748b;
  --color-accent: #7dd3fc;
  --color-accent-light: #a5f3fc;
  --color-accent-dark: #38bdf8;
  --color-accent-08: rgba(125, 211, 252, 0.08);
  --color-accent-03: rgba(125, 211, 252, 0.03);
  --color-accent-04: rgba(125, 211, 252, 0.04);
  --color-accent-06: rgba(125, 211, 252, 0.06);
  --color-accent-10: rgba(125, 211, 252, 0.1);
  --color-accent-12: rgba(125, 211, 252, 0.12);
  --color-accent-15: rgba(125, 211, 252, 0.15);
  --color-accent-bg: rgba(125, 211, 252, 0.15);
  --color-accent-20: rgba(125, 211, 252, 0.2);
  --color-accent-25: rgba(125, 211, 252, 0.25);
  --color-accent-30: rgba(125, 211, 252, 0.3);
  --color-accent-50: rgba(125, 211, 252, 0.5);
  --color-aqua: #7dd3fc;
  --color-aqua-light: #a5f3fc;
  --color-border: #1e293b;
  --color-border-2: #334155;
  --color-border-accent: rgba(125, 211, 252, 0.2);
  --radius-lg: 0;

  --color-sec-fixed: #22c55e;
  --color-sec-open: #ef4444;
  --color-sec-uncertain: #eab308;

  --font-serif: 'Playfair Display', Georgia, serif;
  --font-sans: 'Inter', system-ui, sans-serif;
  --font-mono: 'Space Mono', 'Courier New', monospace;

  --ease-spring-1: linear(0, 0.0039, 0.0157, 0.0352, 0.0625, 0.0977, 0.1407, 0.1914, 0.2493, 0.3138, 0.3837, 0.4581, 0.5365, 0.6175, 0.7003, 0.7836, 0.866, 0.9461, 1.0224, 1.0732, 1.0901, 1.073, 1.0312, 0.9806, 0.9421, 0.9316, 0.9463, 0.9774, 1.0061, 1.0159, 1.0092, 0.9974, 1);
  --ease-spring-soft: linear(0, 0.0039, 0.0157, 0.0352, 0.0625, 0.0977, 0.1406, 0.1914, 0.249, 0.3135, 0.3832, 0.4573, 0.5353, 0.6157, 0.6975, 0.7793, 0.8595, 0.936, 1.0064, 1.0501, 1.0662, 1.0568, 1.0318, 1.003, 0.9844, 0.9818, 0.9936, 1.0076, 1.0116, 1.0048, 0.9968, 1);
}

*, *::before, *::after { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
}

html {
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-sans);
}

body { margin: 0; overflow-x: hidden; -webkit-font-smoothing: antialiased; }

html.lenis, html.lenis body { height: auto; }
.lenis.lenis-smooth { scroll-behavior: auto !important; }
.lenis.lenis-stopped { overflow: hidden; }
.lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }

::selection {
  background-color: var(--color-accent);
  color: var(--color-bg);
}
img::selection { background: transparent; }

::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--color-bg); }
::-webkit-scrollbar-thumb { background: var(--color-border-2); border-radius: 2px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-accent-50); }

.cursor-dot {
  width: 10px; height: 10px; background: var(--color-accent); border-radius: 50%;
  position: fixed; top: 0; left: 0; pointer-events: none; z-index: 9999;
  transform: translate(-50%, -50%);
  transition: width 0.2s ease, height 0.2s ease;
}
.cursor-dot.hovering { width: 16px; height: 16px; background: var(--color-accent-light); }

.font-serif { font-family: var(--font-serif); }
.font-mono { font-family: var(--font-mono); }
.font-sans { font-family: var(--font-sans); }

.accent-underline { position: relative; }
.accent-underline::after {
  content: ''; position: absolute; bottom: -2px; left: 0;
  width: 0; height: 1px; background: var(--color-aqua);
  transition: width .4s cubic-bezier(.16,1,.3,1);
}
.accent-underline:hover::after { width: 100%; }

.section-label {
  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .25em;
  text-transform: uppercase; color: var(--color-text); display: block; margin-bottom: 1rem;
}

.scroll-progress {
  position: fixed; top: 0; left: 0; height: 2px;
  background: var(--color-aqua);
  transform-origin: left; z-index: 9996; width: 100%;
}

.clip-btn {
  position: relative; display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.75rem 1.5rem; overflow: hidden;
  clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
  background: transparent; border: 1px solid var(--color-border-2);
  color: var(--color-text); cursor: pointer;
  font-family: var(--font-mono); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase;
  transition: color .3s, border-color .3s;
}
.clip-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--color-accent-bg);
  clip-path: inset(100% 0 0 0);
  transition: clip-path .5s cubic-bezier(.16,1,.3,1);
  z-index: -1;
}
.clip-btn:hover::before { clip-path: inset(0 0 0 0); }
.clip-btn:hover { color: var(--color-text); border-color: var(--color-aqua); }

.clip-btn-filled {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  overflow: hidden;
  clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
  background: var(--color-accent-bg);
  border: none;
  color: var(--color-text);
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: .8rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  transition: background .3s;
}
.clip-btn-filled:hover {
  background: rgba(125, 211, 252, 0.25);
}

:focus-visible {
  outline: 2px solid var(--color-aqua);
  outline-offset: 2px;
  border-radius: 2px;
}
button:focus-visible, a:focus-visible {
  outline: 2px solid var(--color-aqua);
  outline-offset: 3px;
}
.clip-btn:focus-visible::before { clip-path: inset(0 0 0 0); }
.clip-btn:focus-visible { color: var(--color-text); border-color: var(--color-aqua); }

@media (max-width: 640px) {
  .clip-btn, .clip-btn-filled {
    clip-path: polygon(4% 0, 100% 0, 96% 100%, 0 100%);
    padding: 0.6rem 1.2rem;
    font-size: .75rem;
  }
  .section-label {
    font-size: .6rem;
    letter-spacing: .2em;
  }
}

.bg-surface { background-color: var(--color-bg); }
.bg-surface-deep { background-color: var(--color-bg-deep); }
.bg-card { background-color: var(--color-bg-card); }
.text-muted { color: var(--color-text-3); }
.text-secondary { color: var(--color-text); }
.border-default { border-color: var(--color-border); }

.dot-grid-bg {
  background-image: radial-gradient(circle, var(--color-aqua) 0.5px, transparent 0.5px);
  background-size: 24px 24px;
  opacity: 0.02;
}

.card-hover {
  transition: border-color .3s cubic-bezier(.16,1,.3,1), box-shadow .3s cubic-bezier(.16,1,.3,1);
}
.card-hover:hover {
  border-color: var(--color-accent-25);
  box-shadow: 0 4px 24px rgba(125, 211, 252, 0.06);
}

.section-root {
  padding-top: 8rem;
  padding-bottom: 8rem;
  background-color: var(--color-bg);
}
@media (min-width: 1024px) {
  .section-root {
    padding-top: 10rem;
    padding-bottom: 10rem;
  }
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-serif);
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 0.75rem;
}

h1 { font-size: clamp(2rem, 5vw, 3.5rem); }
h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
h4 { font-size: clamp(1.25rem, 2.5vw, 1.5rem); }

p {
  font-size: 1rem;
  line-height: 1.7;
  margin-bottom: 1rem;
}

.section-container {
  max-width: 80rem;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}
@media (min-width: 1024px) {
  .section-container {
    padding-left: 3rem;
    padding-right: 3rem;
  }
}

.dyslexia-toggle {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  cursor: pointer;
  background: transparent;
  border: none;
  color: var(--color-text-3);
  transition: all 0.2s ease;
  margin-left: 0.5rem;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}
.dyslexia-toggle:hover {
  color: var(--color-accent);
  transform: scale(1.1);
}
.dyslexia-toggle .icon {
  font-weight: 600;
  font-size: 1rem;
}

html.dyslexia-font {
  --font-sans: 'Lexend', sans-serif !important;
  --font-mono: 'Lexend', monospace !important;
}

html.dyslexia-font * {
  font-family: 'Lexend', sans-serif !important;
}

.sec-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.15rem 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 2px;
  border: 1px solid;
}
.sec-badge--fixed {
  color: var(--color-sec-fixed);
  border-color: rgba(34, 197, 94, 0.3);
  background: rgba(34, 197, 94, 0.08);
}
.sec-badge--open {
  color: var(--color-sec-open);
  border-color: rgba(239, 68, 68, 0.3);
  background: rgba(239, 68, 68, 0.08);
}
.sec-badge--uncertain {
  color: var(--color-sec-uncertain);
  border-color: rgba(234, 179, 8, 0.3);
  background: rgba(234, 179, 8, 0.08);
}

.sec-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--color-border);
  background-color: var(--color-bg-card);
  transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s cubic-bezier(.16,1,.3,1);
}
.sec-card:hover {
  border-color: var(--color-border-accent);
  box-shadow: 0 4px 20px rgba(125, 211, 252, 0.06);
  transform: translateY(-2px);
}

.sec-category-badge {
  display: inline-flex;
  align-items: center;
  padding: 0.1rem 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.55rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: 1px solid rgba(125, 211, 252, 0.15);
  color: var(--color-text-3);
  background: rgba(125, 211, 252, 0.04);
}

.sec-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.25rem 1rem;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
}
.sec-stat-value {
  font-family: var(--font-mono);
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1;
}
.sec-stat-label {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-top: 0.5rem;
}

@media (pointer: fine) {
  html { cursor: none; }
  .clip-btn, .clip-btn-filled { cursor: none; }
}
@media (pointer: coarse) {
  .cursor-dot, .cursor-ring, .scroll-progress { display: none !important; }
  .clip-btn, .clip-btn-filled { cursor: pointer; }
  .custom-cursor-target { cursor: auto !important; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
